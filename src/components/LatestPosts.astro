---
import { fetchLatestPosts, formatDate } from '../lib/rss';
import { tagged } from '../lib/utm';

const posts = await fetchLatestPosts('https://blog.javapark.kr/rss.xml', 5);
---

{
  posts.length > 0 && (
    <section class="px-6 py-10 max-w-5xl mx-auto">
      <div class="flex items-baseline justify-between mb-5">
        <div>
          <h2 class="text-xl md:text-2xl font-bold text-white">최근 글</h2>
          <p class="text-sm text-gray-500 mt-1">방금 보신 영상의 전체 해설이 여기 있습니다</p>
        </div>
        <a href="/archive/" class="text-sm text-cyan-400 hover:text-cyan-300 transition">
          전체 글 목록 →
        </a>
      </div>
      <ul class="space-y-2">
        {posts.map((p) => (
          <li>
            <a
              href={tagged(p.link, 'latest_posts')}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-baseline justify-between gap-4 py-3 px-4 rounded-xl border border-white/5 hover:border-white/15 hover:bg-white/[0.04] transition"
            >
              <span class="text-gray-200 group-hover:text-white transition truncate">
                {p.title}
              </span>
              <span class="text-xs text-gray-500 shrink-0 tabular-nums">
                {formatDate(p.pubDate)}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
