---
import { fetchLatestPosts, formatDate } from '../lib/rss';
import { tagged } from '../lib/utm';

// 첫 화면(Hero)이 가장 최근 글을 크게 보여 주므로 여기서는 그다음 4편.
const posts = (await fetchLatestPosts('https://blog.javapark.kr/rss.xml', 5)).slice(1);
---

{
  posts.length > 0 && (
    <section class="px-6 py-10 max-w-6xl mx-auto">
      <div class="flex items-baseline justify-between mb-5">
        <div>
          <h2 class="text-xl md:text-2xl font-bold text-white">최근 글</h2>
          <p class="text-sm text-gray-500 mt-1">방금 보신 영상의 전체 해설이 여기 있습니다</p>
        </div>
        <a href="/archive/" class="text-sm text-cyan-400 hover:text-cyan-300 transition">
          전체 글 목록 →
        </a>
      </div>
      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {posts.map((p) => (
          <li class="group relative">
            <a href={tagged(p.link, 'latest_posts')} class="block">
              {p.thumbnail ? (
                <img
                  src={p.thumbnail}
                  alt=""
                  width="1200"
                  height="630"
                  loading="lazy"
                  class="block aspect-[1200/630] w-full rounded-xl border border-white/5 object-cover transition group-hover:border-white/20"
                />
              ) : (
                <div class="aspect-[1200/630] w-full rounded-xl border border-white/5 bg-gradient-to-br from-indigo-500/20 to-cyan-500/10" />
              )}
              <p class="mt-3 text-[15px] leading-snug text-gray-200 group-hover:text-white transition line-clamp-2">
                {p.title}
              </p>
            </a>
            <div class="mt-1.5 flex items-center gap-2 text-xs text-gray-500">
              <span class="tabular-nums">{formatDate(p.pubDate)}</span>
              {p.shorts && (
                <a
                  href={p.shorts}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-bold text-red-300/80 hover:text-red-200"
                >
                  ▶ 쇼츠
                </a>
              )}
            </div>
          </li>
        ))}
      </ul>
    </section>
  )
}
