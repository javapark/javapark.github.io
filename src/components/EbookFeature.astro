---
import { tagged } from '../lib/utm';

const landingUrl = tagged('https://blog.javapark.kr/backend-cs-ebook/', 'ebook_feature');
---

<section class="px-6 pb-10 max-w-5xl mx-auto" aria-labelledby="ebook-feature-title">
  <a
    href={landingUrl}
    data-ebook-feature
    class="group relative grid overflow-hidden rounded-3xl border border-cyan-300/20 bg-gradient-to-br from-slate-950 via-slate-900 to-indigo-950 shadow-2xl shadow-cyan-950/25 md:grid-cols-[1.15fr_0.85fr]"
  >
    <div class="relative z-10 flex flex-col justify-center p-7 sm:p-9 md:p-11">
      <div class="mb-5 flex flex-wrap items-center gap-2">
        <span class="rounded-full border border-cyan-300/30 bg-cyan-300/10 px-3 py-1 text-[11px] font-bold tracking-[0.16em] text-cyan-200">
          FREE SAMPLE
        </span>
        <span class="text-xs text-slate-400">전자책 출시 준비 중</span>
      </div>

      <h2 id="ebook-feature-title" class="text-3xl font-extrabold leading-tight text-white sm:text-4xl">
        그림으로 말하는<br />
        <span class="text-cyan-300">백엔드 CS 20</span>
      </h2>

      <p class="mt-5 max-w-lg text-sm leading-7 text-slate-300 sm:text-base">
        외우는 정답 대신 시스템 흐름을 그리고, 면접에서 60초로 설명하는 연습을 합니다.
        완성형 5문항이 담긴 15페이지 샘플을 먼저 확인하세요.
      </p>

      <div class="mt-7 flex items-center gap-3">
        <span class="rounded-xl bg-cyan-300 px-5 py-3 text-sm font-extrabold text-slate-950 transition group-hover:bg-cyan-200">
          무료 샘플 보기
        </span>
        <span class="text-sm font-semibold text-slate-400 transition group-hover:translate-x-1 group-hover:text-white">
          바로가기 →
        </span>
      </div>
    </div>

    <div class="relative min-h-[320px] overflow-hidden bg-[radial-gradient(circle_at_center,rgba(34,211,238,0.2),transparent_65%)] sm:min-h-[380px] md:min-h-[420px]">
      <div class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.035)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.035)_1px,transparent_1px)] bg-[size:28px_28px]"></div>
      <img
        src="/backend-cs-ebook-cover.png"
        alt="그림으로 말하는 백엔드 CS 20 무료 샘플 표지"
        width="1080"
        height="1350"
        loading="eager"
        class="absolute left-1/2 top-1/2 w-[210px] -translate-x-1/2 -translate-y-1/2 rotate-2 rounded-lg shadow-2xl shadow-black/60 transition duration-300 group-hover:rotate-0 group-hover:scale-[1.03] sm:w-[235px] md:w-[255px]"
      />
    </div>

    <div class="pointer-events-none absolute -left-24 -top-24 h-64 w-64 rounded-full bg-indigo-500/15 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-32 right-0 h-72 w-72 rounded-full bg-cyan-400/10 blur-3xl"></div>
  </a>
</section>

<script is:inline>
  (() => {
    const inbound = new URLSearchParams(window.location.search);
    let source = inbound.get('utm_source');
    let medium = inbound.get('utm_medium');

    if (!source && document.referrer) {
      try {
        const referrerHost = new URL(document.referrer).hostname;
        if (referrerHost.includes('instagram.com')) {
          source = 'instagram';
          medium = 'profile';
        }
      } catch {
        // Invalid referrers fall back to portal attribution.
      }
    }

    document.querySelectorAll('[data-ebook-feature]').forEach((link) => {
      const url = new URL(link.href);
      if (source) url.searchParams.set('utm_source', source);
      if (medium) url.searchParams.set('utm_medium', medium);
      url.searchParams.set('utm_campaign', 'backend_cs_ebook');
      url.searchParams.set('utm_content', 'portal_feature_card');
      link.href = url.toString();
    });
  })();
</script>
